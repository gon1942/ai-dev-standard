{
  "name": "@gon1942/ai-dev-standard",
  "version": "0.1.5",
  "description": "공통 개발 표준 프레임워크 — Codex·OpenCode·Claude Code를 동일한 절차로 계획·구현·검증·기록하게 만드는 CLI",
  "bin": {
    "ai-dev-standard": "bin/ai-dev-standard.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "global-hooks/",
    "templates/",
    "docs/",
    ".opencode/skills/",
    ".opencode/agents/",
    ".claude/skills/",
    ".claude/settings.json",
    ".claude/commands/",
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "dist/template/",
    "!docs/product-specs/*",
    "!docs/exec-plans/",
    "!docs/generated/project-preflight.md",
    "!docs/generated/project-preflight.json",
    "!docs/generated/project-context-intake.md",
    "!docs/generated/framework-apply-plan.md",
    "!scripts/reference/",
    "vendor/"
  ],
  "scripts": {
    "build:template": "rm -rf dist/template && bash scripts/build-framework-template.sh --output dist/template",
    "prepare": "npm run build:template",
    "prepack": "npm run build:template",
    "prepublishOnly": "npm run build:template"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
